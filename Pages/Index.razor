@page "/"
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@implements IAsyncDisposable
@using BlazorApp.Models

<div class="section-container" id="home">
    <div class="hero-section">
        <div class="hero-content">
            <h1>Merhaba, Ben Melikşah</h1>
            <p>.NET Full Stack Developer & Yazılım Mimarı</p>
            <div class="social-links">
                <a href="#" class="social-link"><i class="fab fa-github"></i></a>
                <a href="#" class="social-link"><i class="fab fa-linkedin"></i></a>
                <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
            </div>
        </div>
    </div>
    <button class="scroll-arrow" @onclick='() => ScrollToSection("skills")'>
        <i class="fas fa-chevron-down"></i>
    </button>
</div>

<div class="section-container" id="skills">
    <div class="section">
        <div class="container">
            <h2 class="section-title">Yeteneklerim</h2>
            <div class="skill-grid">
                @if (_portfolioData?.Skills != null)
                {
                    @foreach (var skill in _portfolioData.Skills)
                    {
                        <div class="card">
                            <h3>@skill.Title</h3>
                            <p>@skill.Technologies</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <button class="scroll-arrow" @onclick='() => ScrollToSection("projects")'>
        <i class="fas fa-chevron-down"></i>
    </button>
</div>

<div class="section-container" id="projects">
    <div class="section">
        <div class="container">
            <h2 class="section-title">Projelerim</h2>
            <div class="project-grid">
                @if (_portfolioData?.Projects != null)
                {
                    @foreach (var project in _portfolioData.Projects)
                    {
                        <div class="project-card">
                            <h3>@project.Title</h3>
                            <p>@project.Description</p>
                            <p class="tech-stack">@project.TechStack</p>
                            <div class="project-features">
                                <ul>
                                    @foreach (var feature in project.Features)
                                    {
                                        <li>@feature</li>
                                    }
                                </ul>
                            </div>
                            <a href="#" class="btn">Detaylar</a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <button class="scroll-arrow" @onclick='() => ScrollToSection("contact")'>
        <i class="fas fa-chevron-down"></i>
    </button>
</div>

<div class="section-container" id="contact">
    <div class="section">
        <div class="container">
            <h2 class="section-title">İletişim</h2>
            <div class="contact-form">
                <div class="form-group">
                    <input type="text" class="form-control" placeholder="Adınız">
                </div>
                <div class="form-group">
                    <input type="email" class="form-control" placeholder="E-posta Adresiniz">
                </div>
                <div class="form-group">
                    <textarea class="form-control" rows="5" placeholder="Mesajınız"></textarea>
                </div>
                <button class="btn">Gönder</button>
            </div>
        </div>
    </div>
</div>

@code {
    private IJSObjectReference? _module;
    private PortfolioData? _portfolioData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _portfolioData = await Http.GetFromJsonAsync<PortfolioData>("data/portfolio.json");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading portfolio data: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/index.js");
            await _module.InvokeVoidAsync("initializeAnimations");
        }
    }

    private async Task ScrollToSection(string sectionId)
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("scrollToSection", sectionId);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
} 